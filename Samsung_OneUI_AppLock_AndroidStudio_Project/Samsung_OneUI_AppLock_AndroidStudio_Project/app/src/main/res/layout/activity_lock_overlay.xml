<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#000000"
    android:padding="24dp">

    <ImageView
        android:id="@+id/lockedAppIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/lockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Locked"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter PIN or use Samsung Biometrics"
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp" />

    <!-- PIN dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="36dp">

        <View android:id="@+id/dot0" android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="8dp" android:background="@drawable/dot_empty" />
        <View android:id="@+id/dot1" android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="8dp" android:background="@drawable/dot_empty" />
        <View android:id="@+id/dot2" android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="8dp" android:background="@drawable/dot_empty" />
        <View android:id="@+id/dot3" android:layout_width="14dp" android:layout_height="14dp" android:layout_margin="8dp" android:background="@drawable/dot_empty" />
    </LinearLayout>

    <!-- Keypad grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btn1" style="@style/KeypadButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/KeypadButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/KeypadButton" android:text="3" />

        <Button android:id="@+id/btn4" style="@style/KeypadButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/KeypadButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/KeypadButton" android:text="6" />

        <Button android:id="@+id/btn7" style="@style/KeypadButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/KeypadButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/KeypadButton" android:text="9" />

        <Button android:id="@+id/btnCancel" style="@style/KeypadButton" android:text="Cancel" android:textSize="12sp" />
        <Button android:id="@+id/btn0" style="@style/KeypadButton" android:text="0" />
        <Button android:id="@+id/btnDelete" style="@style/KeypadButton" android:text="⌫" />
    </GridLayout>

    <!-- Biometric button -->
    <ImageView
        android:id="@+id/biometricIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="Biometrics" />
</LinearLayout>
